# Partial backend config: terraform init -backend-config=backends/uat.s3.tfbackend
# The event stack's OWN uat state bucket (owner decision 2026-09-30), created
# by infrastructure/deploy/bootstrap-uat.sh before the first init -- init needs
# the bucket to exist before Terraform can evaluate anything. Same shape as
# echo's uif-echo-uat-data.
bucket       = "uif-event-uat-data"
key          = "tfstate/event-terraform.tfstate"
region       = "eu-west-1"
use_lockfile = true
encrypt      = true
