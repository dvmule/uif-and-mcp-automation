{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::uif-echo-dev-data",
        "arn:aws:s3:::uif-echo-dev-data/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowEchoDevGitHubActions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::283556840805:role/echo-dev-github-actions"
      },
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning",
        "s3:GetBucketLocation",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::uif-echo-dev-data"
    },
    {
      "Sid": "AllowEchoDevGitHubActionsObjects",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::283556840805:role/echo-dev-github-actions"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::uif-echo-dev-data/*"
    }
  ]
}
