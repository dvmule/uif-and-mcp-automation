{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::uif-echo-uat-data"
    },
    {
      "Sid": "StateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::uif-echo-uat-data/tfstate/infra-terraform.tfstate",
        "arn:aws:s3:::uif-echo-uat-data/tfstate/infra-terraform.tfstate.tflock",
        "arn:aws:s3:::uif-echo-uat-data/tfstate/gold-terraform.tfstate",
        "arn:aws:s3:::uif-echo-uat-data/tfstate/gold-terraform.tfstate.tflock"
      ]
    }
  ]
}